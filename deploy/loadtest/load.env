# For seeding only: no durability, and most of the memory for the HNSW build.
LT_SHM_SIZE=3g
LT_PG_FLAGS=-c fsync=off -c synchronous_commit=off -c full_page_writes=off -c wal_level=minimal -c max_wal_senders=0 -c max_wal_size=4GB -c shared_buffers=256MB -c autovacuum=off -c max_parallel_maintenance_workers=7 -c max_worker_processes=16
