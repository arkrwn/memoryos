# Copy to deploy/.env, which git ignores. Docker Compose reads it from that directory.

# Required. It goes into a database URL, so use URL-safe characters: openssl rand -hex 32
POSTGRES_PASSWORD=

# Where the API is published on the host. /healthz, /readyz and /metrics answer without a token,
# so put a reverse proxy with TLS in front before binding to a public address.
MEMORYOS_PUBLISH=127.0.0.1:8080

# Memory limit of the server container. The local embedder needs at least 1 GiB; 768m is OOM killed.
MEMORYOS_MEM_LIMIT=1536m

# Optional. An empty value counts as unset. Defaults are in docs/SPEC.md section 10.
RUST_LOG=
MEMORYOS_RATE_LIMIT_RPS=
MEMORYOS_DB_MAX_CONNECTIONS=
MEMORYOS_REQUEST_TIMEOUT_SECS=
MEMORYOS_MCP_ALLOWED_ORIGINS=
OTEL_EXPORTER_OTLP_ENDPOINT=

# Worker mode only (service memoryos-worker).
MEMORYOS_LLM_PROVIDER=
MEMORYOS_LLM_MODEL=
ANTHROPIC_API_KEY=
ANTHROPIC_BASE_URL=
OPENAI_API_KEY=
OPENAI_BASE_URL=
MEMORYOS_EMBEDDING_MODEL=
MEMORYOS_WORKER_CONCURRENCY=
MEMORYOS_TURN_TIMEOUT_SECS=
# Must match what the database already holds: vectors from different models cannot be compared.
MEMORYOS_WORKER_EMBEDDER=openai
